# Copy to .env.docker (gitignored) before running docker compose.

# Postgres
POSTGRES_DB=ecommerce
POSTGRES_USER=ecommerce
POSTGRES_PASSWORD=change-me

# Django (production settings)
DJANGO_SETTINGS_MODULE=config.settings.production
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1,backend
DATABASE_URL=postgres://ecommerce:change-me@db:5432/ecommerce
CORS_ALLOWED_ORIGINS=http://localhost:3000
FRONTEND_BASE_URL=http://localhost:3000
DEFAULT_FROM_EMAIL=orders@lumen.example

# Stripe (optional — leave blank to keep the dev bypass off in production)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Media on S3 / Cloudflare R2 (optional — leave bucket blank to use local media).
# For Cloudflare R2, also set AWS_S3_ENDPOINT_URL to your R2 endpoint.
AWS_STORAGE_BUCKET_NAME=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_REGION_NAME=
AWS_S3_ENDPOINT_URL=
AWS_S3_CUSTOM_DOMAIN=

# Sentry error monitoring (optional — leave blank to disable).
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1

# SMTP email (optional in dev; configure for real order emails in production)
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
